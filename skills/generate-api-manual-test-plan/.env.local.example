# Example .env.local for the generate-api-manual-test-plan skill.
#
# Copy this to <your-service-dir>/.env.local, fill in the placeholder values,
# and ensure your top-level .gitignore includes `.env*.local`. Then source it
# in the shell that starts your local service:
#
#   cd <your-service-dir>
#   source .env.local && <your start command>
#
# The skill reads this file during its preflight phase to derive the Dash0
# ingress host, app host, dataset, service name, org slug, and any local API
# auth tokens — so you don't have to re-answer questions on every plan run.
#
# Anything marked REQUIRED must be filled in. Optional vars unlock specific
# features (HTTP-only logs exporter, tenant-scoped routes, etc.).

# --- REQUIRED: Dash0 ingestion ---------------------------------------------
# Mint the auth token in the Dash0 UI: Settings → Auth Tokens.
# Treat it like a password — never commit, rotate periodically.
export DASH0_AUTH_TOKEN=auth_REPLACE_WITH_YOUR_TOKEN
export DASH0_DATASET=default

# gRPC OTLP endpoint for traces + metrics. Pick the host matching your org's
# region. Examples:
#   https://ingress.eu-west-1.aws.dash0.com:4317        (EU prod)
#   https://ingress.us-east-1.aws.dash0.com:4317        (US prod)
#   https://ingress.<region>.aws.dash0-dev.com:4317     (dev env)
export OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com:4317
export OTEL_EXPORTER_OTLP_HEADERS="Dash0-Dataset=$DASH0_DATASET,Authorization=Bearer $DASH0_AUTH_TOKEN"

# --- REQUIRED: Dash0 UI deep-link targeting --------------------------------
# DASH0_ORG is the slug after `?org=` in any working Dash0 UI URL you've
# opened. Without it, every generated trace/log link returns
# "Organization not found".
#
# DASH0_APP_HOST is the UI host paired with the ingress region above:
#   app.dash0.com         pairs with ingress.<region>.aws.dash0.com
#   app.dash0-dev.com     pairs with ingress.<region>.aws.dash0-dev.com
export DASH0_ORG=your-org-slug
export DASH0_APP_HOST=app.dash0.com

# --- REQUIRED: Service identity --------------------------------------------
# Pick a name unique to your laptop so Dash0 deep-links scope to YOUR local
# instance, not someone else's or a deployed copy. Convention:
# <service>-<your-name>-local.
export OTEL_SERVICE_NAME=my-service-yourname-local
export OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local-yourname

# --- OPTIONAL: HTTP-only logs exporter -------------------------------------
# Uncomment if your service uses a logs exporter that does NOT inherit the
# master gRPC OTEL_EXPORTER_OTLP_* vars (e.g. agoda-com/opentelemetry-logs-go).
# Signal-specific endpoint variables expect the FULL URL including /v1/logs.
#
# export OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com/v1/logs
# export OTEL_EXPORTER_OTLP_LOGS_HEADERS="Dash0-Dataset=$DASH0_DATASET,Authorization=Bearer $DASH0_AUTH_TOKEN"

# --- OPTIONAL: Local-service admin auth ------------------------------------
# If your service requires Bearer auth on the routes under test, export the
# token here so the skill doesn't re-prompt every plan run. The skill looks
# for these names in priority order (first match wins):
#
#   API_TOKEN, API_BEARER, LOCAL_API_BEARER, LOCAL_API_TOKEN,
#   plus any project-prefixed alias (e.g. MY_SERVICE_API_TOKEN).
#
# Aliasing is fine — define one canonical var and alias the others to it.
#
# export API_TOKEN=REPLACE_WITH_YOUR_LOCAL_ADMIN_TOKEN
# export API_BEARER=$API_TOKEN

# --- OPTIONAL: Tenant context ----------------------------------------------
# If your routes are tenant-scoped (URL path /tenants/<id>/... or a body
# field), export the local-tenant identifier here. The skill looks for:
#
#   TENANT_ID, ORG_ID, ORG_TECHNICAL_ID, plus project-prefixed aliases.
#
# DO NOT use DASH0_ORG for this — that's the Dash0 UI slug, a different
# thing. See the "two identifiers" callout in README.md.
#
# export TENANT_ID=your-local-tenant-id
